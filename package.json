{
  "name": "elixir-context",
  "private": true,
  "version": "0.1.0",
  "description": "Semantic and call-graph context for Elixir codebases, exposed to coding CLIs over MCP.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fosferon/elixir-context.git"
  },
  "homepage": "https://github.com/fosferon/elixir-context#readme",
  "bugs": {
    "url": "https://github.com/fosferon/elixir-context/issues"
  },
  "bin": {
    "elixir-context": "bin/elixir-context.js"
  },
  "scripts": {
    "ec:export": "bash -lc 'cd ${PROJECT_ROOT:-${npm_config_project:-$PWD}} && mix run ${EXPORTER:-scripts/export.exs} --quiet --out ${DATA_DIR:-${npm_config_data:-$PWD/.elixir_context}}/export.jsonl'",
    "ec:ingest": "node scripts/ingest.js ${DATA_DIR:-${npm_config_data:-$PWD/.elixir_context}}/export.jsonl ${DATA_DIR:-${npm_config_data:-$PWD/.elixir_context}}/ec.sqlite",
    "ec:build": "npm run ec:export && npm run ec:ingest",
    "ec:serve": "node scripts/mcp-stdio.js --db ${DATA_DIR:-${npm_config_data:-$PWD/.elixir_context}}/ec.sqlite",
    "ec:watch": "node scripts/watch.js --root ${PROJECT_ROOT:-${npm_config_project:-$PWD}} --db ${DATA_DIR:-${npm_config_data:-$PWD/.elixir_context}}/ec.sqlite --exporter ${EXPORTER:-scripts/export.exs}",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.9",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  },
  "files": [
    "bin/",
    "scripts/build.js",
    "scripts/export.exs",
    "scripts/ingest.js",
    "scripts/logger.js",
    "scripts/mcp-stdio.js",
    "scripts/parse-heex.js",
    "scripts/query.js",
    "scripts/ripgrep-search.js",
    "scripts/start-with-watch.sh",
    "scripts/utils.js",
    "scripts/watch.js",
    "docs/",
    "README.md",
    "LICENSE"
  ]
}

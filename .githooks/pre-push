#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
#
# Runs the public guard over every commit being pushed, not just the working tree:
# a leak committed and later removed would otherwise still be published in history.
set -euo pipefail
top="$(git rev-parse --show-toplevel)"
scanner="$top/scripts/public_guard_commits.sh"
default_extra="$HOME/.config/fosferon/public-guard-extra.txt"
# Extras (client names) are optional for contributors. Require them only when an
# extras file is configured locally; CI sets PUBLIC_GUARD_REQUIRE_EXTRA itself.
if [[ -n "${PUBLIC_GUARD_EXTRA_FILE:-}" ]]; then
  export PUBLIC_GUARD_REQUIRE_EXTRA="${PUBLIC_GUARD_REQUIRE_EXTRA:-1}"
elif [[ -r "$default_extra" ]]; then
  export PUBLIC_GUARD_EXTRA_FILE="$default_extra"
  export PUBLIC_GUARD_REQUIRE_EXTRA="${PUBLIC_GUARD_REQUIRE_EXTRA:-1}"
else
  unset PUBLIC_GUARD_EXTRA_FILE PUBLIC_GUARD_REQUIRE_EXTRA
  echo "pre-push: no extras file configured; built-in patterns checked, extras were not checked" >&2
fi
remote="${1:-origin}"
zero=0000000000000000000000000000000000000000
status=0
while read -r _lref lsha _rref rsha; do
  [[ "$lsha" == "$zero" ]] && continue                       # branch deletion
  # A remote sha we do not have (unfetched force-push target, pruned object) falls
  # back to everything not already on the remote, instead of an empty range.
  if [[ "$rsha" == "$zero" ]] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    range=("$lsha" --not --remotes="$remote")
  else range=("$rsha..$lsha"); fi
  if ! bash "$scanner" "${range[@]}"; then status=1; fi
done
exit $status
